# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://lexiflow:lexiflow@localhost:5432/lexiflow?schema=public

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=30d

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000

# ─── AI provider (Groq recommended, OpenRouter fallback) ────────────────────
GROQ_API_KEY=
# GEMINI_API_KEY=
# OPEN_ROUTER=

# ─── YouTube Data API ────────────────────────────────────────────────────────
YOUTUBE_API_KEY=
USE_MOCK_YOUTUBE=false

# ─── SpeechSuper (pronunciation assessment) ─────────────────────────────────
SPEECHSUPER_API_KEY=
SPEECHSUPER_APP_KEY=
